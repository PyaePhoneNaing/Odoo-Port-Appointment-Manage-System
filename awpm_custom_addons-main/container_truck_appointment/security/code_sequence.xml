<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="seq_container_truck_export" model="ir.sequence">
            <field name="name">Container Truck Export Sequence</field>
            <field name="code">container.truck.export</field>
            <field name="prefix">%(year)s/%(month)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_container_truck_import" model="ir.sequence">
            <field name="name">Container Truck Import Sequence</field>
            <field name="code">container.truck.import</field>
            <field name="prefix">%(year)s/%(month)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>