<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="container_truck_appointment.module_container_truck">
        <field name="name">AWPM Security Group</field>
        <field name="description">Container Truck Appointment</field>
        <field name="sequence">2</field>
    </record>

    <record id="group_awpm_shipping" model="res.groups">
        <field name="name">Shipping Line</field>
        <field name="category_id" ref="container_truck_appointment.module_container_truck"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_awpm_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="container_truck_appointment.module_container_truck"/>
        <field name="implied_ids" eval="[(4, ref('container_truck_appointment.group_awpm_shipping'))]"/>
    </record>

    <record id="group_awpm_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="container_truck_appointment.module_container_truck"/>
        <field name="implied_ids" eval="[(4, ref('container_truck_appointment.group_awpm_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_allow_export_print" model="res.groups">
        <field name="name">Disable Print Button</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

</odoo>
