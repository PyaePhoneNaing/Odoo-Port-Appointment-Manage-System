<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="container_truck_appointment_export_rule_awpm_user" model="ir.rule">
        <field name="name">Container Truck Appointment: Agent's Own Records</field>
        <field name="model_id" ref="model_container_truck_appointment_export"/>
        <field name="domain_force">[('agent_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
        <field name="groups" eval="[(4, ref('container_truck_appointment.group_awpm_user'))]"/>
    </record>

