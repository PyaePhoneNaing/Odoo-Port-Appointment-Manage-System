<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="container_truck_appointment_export_view_tree" model="ir.ui.view">
        <field name="name">container.truck.appointment.export.tree</field>
        <field name="model">container.truck.appointment.export</field>
        <field name="arch" type="xml">
            <tree string="Container Truck Appointment Export Tree" default_order='state desc'>
                <field name="name"/>
                <field name="booking_no"/>
                <field name="appointment_date"/>
                <field name="time"/>
                <field name="agent_id"/>
                <field name="shipper_id"/>
                <field name="control_no"/>
                <field name="voyage_id"/>
                <field name="vessel_id"/>
                <field name="state"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'request'"
                       decoration-primary="state == 'approve'"
                       decoration-danger="state == 'cancel'"
                       widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="container_truck_appointment_export_view_kanban" model="ir.ui.view">
        <field name="name">container_truck_appointment_export_view_kanban</field>
        <field name="model">container.truck.appointment.export</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="booking_no"/>
                <field name="appointment_date"/>
                <field name="time"/>
                <field name="agent_id"/>
                <field name="shipper_id"/>
                <field name="control_no"/>
                <field name="voyage_id"/>
                <field name="vessel_id"/>
                <field name="state"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_title">
                                    <strong>
                                        <div class="row">
                                            <div class="col">
                                                <field name="name" class="o_kanban_title"/>
                                            </div>
                                            <div class="col">
                                                <field name="shipper_id"/>
                                            </div>
                                        </div>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col">
                                        <field name="booking_no"/>
                                    </div>
                                    <div class="col">
                                        <field name="agent_id"/>
                                    </div>
                                </div>
                                <div>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'request': 'warning', 'approve': 'success', 'cancel': 'danger'}}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="vessel_id"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <strong>
                                        <field name="voyage_id"/>
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="container_truck_appointment_export_action" model="ir.actions.act_window">
        <field name="name">Container Truck Appointment (Export)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">container.truck.appointment.export</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'default_is_company': True}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no Container Truck Appointment (Export). Click here to add new Container Truck Appointment
                (Export).
            </p>
        </field>
    </record>

    <record id="export_view_form" model="ir.ui.view">
        <field name="name">export_view_form</field>
        <field name="model">container.truck.appointment.export</field>
        <field name="arch" type="xml">
            <form string="Export Form"
                  groups="container_truck_appointment.group_awpm_shipping"
                  __validate__="1">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,request,approve,cancel"
                           statusbar_colors='{"approved":"red"}'
                           groups="container_truck_appointment.group_awpm_manager,container_truck_appointment.group_awpm_user"/>
                    <button name="action_request" string="Request" type="object" states="draft" class="oe_highlight"
                            groups="container_truck_appointment.group_awpm_manager,container_truck_appointment.group_awpm_user"/>
                    <button name="action_approve" string="Approve" type="object" states="request" class="oe_highlight"
                            groups="container_truck_appointment.group_awpm_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" states="request,approve"
                            class="oe_highlight"
                            groups="container_truck_appointment.group_awpm_manager,container_truck_appointment.group_awpm_user"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="cancel"
                            class="oe_highlight"
                            groups="container_truck_appointment.group_awpm_manager,container_truck_appointment.group_awpm_user"/>
                    <button name="%(action_export_report)d" string="Print Slip" type="action"
                            attrs="{'invisible': [('can_print', '=', False)]}" class="oe_highlight"/>
                    <field name="can_print" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="qr_code" widget="image" class="oe_avatar"/>
                        <group string="Container Information">
                            <field name="vessel_id"/>
                            <field name="voyage_id"
                                   attrs="{'readonly': [('voyage_readonly', '=', True), ('id', '!=', False)]}"/>
                            <field name="booking_no"/>
                            <field name="control_no"/>
                            <field name="export_declaration_no"/>
                        </group>
                        <group string="General Information">
                            <field name="shipper_id"/>
                            <field name="appointment_date"/>
                            <field name="time"/>
                            <field name="agent_id"/>
                            <field name="commodity"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Container Line" string="Container Line">
                            <field name="export_line_ids">
                                <tree string="Container Line" editable="1" style="text-align: left;">
                                    <field name="container_id"/>
                                    <button name="action_draft" string="Draft" type="object"
                                            class="btn-danger" groups="container_truck_appointment.group_awpm_manager"/>
                                    <button name="action_done" string="Done" type="object"
                                            class="btn-success" groups="container_truck_appointment.group_awpm_manager"/>
                                    <field name="state"
                                           decoration-danger="state == 'draft'"
                                           decoration-primary="state == 'done'"
                                           widget="badge"/>
                                    <button name="action_generate_report" string="Print Slip" type="object"
                                            attrs="{'invisible': [('can_print', '=', False)]}" class="btn-info"/>
                                    <field name="can_print" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- Hidden field to ensure 'voyage_readonly' is present in the view -->
                <field name="voyage_readonly" invisible="1"/>

                <!-- Odoo Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="shift_view_tree" model="ir.ui.view">
        <field name="name">shift_view_tree</field>
        <field name="model">shift</field>
        <field name="arch" type="xml">
            <tree string="Shift" editable="top" create="1" multi_edit="1">
                <field name="name"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="start_date" widget="date"/>
                <field name="end_date" widget="date"/>
                <field name="containers"/>
                <field name="sequence"/>
            </tree>
        </field>
    </record>

    <record id="shift_action" model="ir.actions.act_window">
        <field name="name">Shift</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shift</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="vessel_view_tree" model="ir.ui.view">
        <field name="name">vessel_view_tree</field>
        <field name="model">vessel</field>
        <field name="arch" type="xml">
            <tree string="Vessel" editable="top" create="1">
                <field name="name"/>
                <field name="shipping_line_id"/>
                <field name="built"/>
                <field name="flag_id"/>
                <field name="gross_tonnage"/>
                <field name="deadweight_tonnage"/>
                <field name="size"/>
                <field name="voyage_ids" widget="many2many_tags"/>
                <field name="external_id"/>
            </tree>
        </field>
    </record>

    <record id="vessel_action" model="ir.actions.act_window">
        <field name="name">Vessel</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vessel</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="voyage_view_tree" model="ir.ui.view">
        <field name="name">voyage_view_tree</field>
        <field name="model">voyage</field>
        <field name="arch" type="xml">
            <tree string="Voyage" editable="top" create="1">
                <field name="name"/>
                <field name="vessel_id"/>
                <field name="voyage_type"/>
                <field name="container_ids" widget="many2many_tags"/>
                <field name="external_id"/>
            </tree>
        </field>
    </record>

    <record id="voyage_action" model="ir.actions.act_window">
        <field name="name">Voyage</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">voyage</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="booking_reference_view_tree" model="ir.ui.view">
        <field name="name">booking_reference_view_tree</field>
        <field name="model">booking.reference</field>
        <field name="arch" type="xml">
            <tree string="Booking Reference" editable="top" create="1">
                <field name="name"/>
                <field name="container_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="booking_reference_action" model="ir.actions.act_window">
        <field name="name">Booking Reference</field>
        <field name="res_model">booking.reference</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="container_view_tree" model="ir.ui.view">
        <field name="name">container_view_tree</field>
        <field name="model">container</field>
        <field name="arch" type="xml">
            <tree string="Container" editable="top" create="1">
                <field name="name"/>
                <field name="voyage_id"/>
                <field name="booking_reference_id"/>
                <field name="external_id"/>
            </tree>
        </field>
    </record>

    <record id="container_action" model="ir.actions.act_window">
        <field name="name">Container</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">container</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="announcement_view_tree" model="ir.ui.view">
        <field name="name">announcement_view_tree</field>
        <field name="model">announcement</field>
        <field name="arch" type="xml">
            <tree string="Announcement" create="1">
                <field name="name"/>
                <field name="message" widget="html"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="announcement_view_form" model="ir.ui.view">
        <field name="name">announcement_view_form</field>
        <field name="model">announcement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Announcement">
                        <field name="name"/>
                        <field name="message" widget="html"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="announcement_action" model="ir.actions.act_window">
        <field name="name">Announcement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">announcement</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
