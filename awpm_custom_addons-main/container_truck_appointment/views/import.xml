<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="container_truck_appointment_import" name="Container Truck Appointment (Import)">
        <t t-call="container_truck_appointment.layout"/>
    </template>

    <record id="container_truck_appointment_import_view_tree" model="ir.ui.view">
        <field name="name">container_truck_appointment_import_view_tree</field>
        <field name="model">container.truck.appointment.import</field>
        <field name="arch" type="xml">
            <tree string="container_truck_appointment_import_tree" default_order='state desc'>
                <field name="name"/>
                <field name="appointment_date"/>
                <field name="time"/>
                <field name="agent_id"/>
                <field name="shipper_id"/>
                <field name="voyage_id"/>
                <field name="vessel_id"/>
                <field name="bill_of_landing"/>
                <field name="gate_information"/>
                <field name="state"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'request'"
                       decoration-primary="state == 'approve'"
                       decoration-danger="state == 'cancel'"
                       widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View Definition-->
    <record id="container_truck_appointment_import_view_kanban" model="ir.ui.view">
        <field name="name">container_truck_appointment_import_view_kanban</field>
        <field name="model">container.truck.appointment.import</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="appointment_date"/>
                <field name="time"/>
                <field name="agent_id"/>
                <field name="shipper_id"/>
                <field name="voyage_id"/>
                <field name="vessel_id"/>
                <field name="state"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_title">
                                    <strong>
                                        <div class="row">
                                            <div class="col">
                                                <field name="name" class="o_kanban_title"/>
                                            </div>
                                            <div class="col">
                                                <field name="shipper_id"/>
                                            </div>
                                        </div>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col">
                                        <field name="agent_id"/>
                                    </div>
                                </div>
                                <div>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'request': 'warning', 'approve': 'success', 'cancel': 'danger'}}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="vessel_id"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <strong>
                                        <field name="voyage_id"/>
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="container_truck_appointment_import_action" model="ir.actions.act_window">
        <field name="name">Container Truck Appointment (Import)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">container.truck.appointment.import</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'default_is_company': True}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no Container Truck Appointment (Import) click here to add new Container Truck Appointment
                (Import).
            </p>
        </field>
    </record>

    <record id="import_view_form" model="ir.ui.view">
        <field name="name">import_view_form</field>
        <field name="model">container.truck.appointment.import</field>
        <field name="arch" type="xml">
            <form string="import_form"
                  groups="container_truck_appointment.group_awpm_shipping">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,request,approve,cancel"
                           statusbar_colors='{"approved":"red"}'
                           groups="container_truck_appointment.group_awpm_user,container_truck_appointment.group_awpm_manager"/>
                    <button name="action_request" string="Request" type="object" states="draft" class="oe_highlight"
                            groups="container_truck_appointment.group_awpm_user,
                                                                                                                             container_truck_appointment.group_awpm_manager"/>
                    <button name="action_approve" string="Approve" type="object" states="request" class="oe_highlight"
                            groups="container_truck_appointment.group_awpm_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" states="request,approve"
                            class="oe_highlight" groups="container_truck_appointment.group_awpm_user,
                                                                                                                             container_truck_appointment.group_awpm_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="cancel"
                            class="oe_highlight" groups="container_truck_appointment.group_awpm_user,
                                                                                                                                            container_truck_appointment.group_awpm_manager"/>
                    <button name="%(action_import_report)d" string="Print Slip" type="action"
                            attrs="{'invisible': [('can_print', '=', False)]}" class="oe_highlight"/>
                    <field name="can_print" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="qr_code" widget="image" class="oe_avatar"/>
                        <group string="Container Information">
                            <field name="vessel_id"/>
                            <field name="voyage_id"/>
                            <field name="bill_of_landing"/>
                        </group>
                        <group string="General Information">
                            <field name="shipper_id"/>
                            <field name="appointment_date"/>
                            <field name="time"/>
                            <field name="agent_id"/>
                            <field name="gate_information" groups="container_truck_appointment.group_awpm_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Container Line" string="Container Line">
                            <field name="import_line_ids">
                                <tree string="Container Line" editable="1">
                                    <field name="container_id"/>
                                    <button name="action_draft" string="Draft" type="object"
                                            class="btn-danger" groups="container_truck_appointment.group_awpm_manager"/>
                                    <button name="action_done" string="Done" type="object"
                                            class="btn-success"
                                            groups="container_truck_appointment.group_awpm_manager"/>
                                    <field name="state"
                                           decoration-danger="state == 'draft'"
                                           decoration-primary="state == 'done'"
                                           widget="badge"/>
                                    <button name="action_generate_report" string="Print Slip" type="object"
                                            attrs="{'invisible': [('can_print', '=', False)]}" class="btn-info"/>
                                    <field name="can_print" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- Odoo Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="bill_of_landing_view_tree" model="ir.ui.view">
        <field name="name">bill_of_landing_view_tree</field>
        <field name="model">bill.of.landing</field>
        <field name="arch" type="xml">
            <tree string="Bill of Landing" editable="top" create="1">
                <field name="name"/>
                <field name="container_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="bill_of_landing_action" model="ir.actions.act_window">
        <field name="name">Bill Of Landing</field>
        <field name="res_model">bill.of.landing</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>