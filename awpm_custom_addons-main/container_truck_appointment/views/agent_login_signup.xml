<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="agent_signup" inherit_id="auth_signup.signup" name="Agent Registration Form">
        <xpath expr="//form[hasclass('oe_signup_form')]" position="replace">
            <form class="oe_signup_form" role="form" method="post" t-if="not message" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"
                       reroute="agent_login_signup.xml"/>

                <div class="profile-image-section">
                    <div class="d-flex justify-content-center mb-4">
                        <img id="selectedAvatar"
                             src="/container_truck_appointment/static/img/signup.jpg"
                             class="rounded-circle bg-secondary"
                             alt="Profile Picture"/>
                    </div>
                    <div class="d-flex justify-content-center mb-4">
                        <div data-mdb-button-init="1" data-mdb-ripple-init="1"
                             class="btn btn-primary btn-rounded">
                            <label class="form-label text-white m-1" for="image">Choose file
                            </label>
                            <input name="image" type="file" class="form-control d-none" id="image"
                                   accept="image/*"/>
                            <input type="hidden" id="image_medium" name="image_medium"/>
                        </div>
                    </div>
                </div>

                <div class="row mb-3 field-code">
                    <div class="col-4">
                        <label for="code">Code</label>
                    </div>
                    <div class="col">
                        <input type="text" name="code" t-att-value="code" id="code" class="form-control form-control-sm"
                               autofocus="autofocus"
                               autocapitalize="off" required="required"
                               t-att-readonly="'readonly' if only_passwords else None"/>
                    </div>
                </div>

                <div class="row mb-3 field-name">
                    <div class="col-4">
                        <label for="name">Name</label>
                    </div>
                    <div class="col">
                        <input type="text" name="name" t-att-value="name" id="name" class="form-control form-control-sm"
                               placeholder="e.g. John Doe"
                               required="required" t-att-readonly="'readonly' if only_passwords else None"
                               t-att-autofocus="'autofocus' if login and not only_passwords else None"/>
                    </div>
                </div>

                <div class="row mb-3 field-login">
                    <div class="col-4">
                        <label for="login">Email</label>
                    </div>
                    <div class="col">
                        <input type="text" name="login" t-att-value="login" id="login"
                               class="form-control form-control-sm" autofocus="autofocus"
                               autocapitalize="off" required="required"
                               t-att-readonly="'readonly' if only_passwords else None"/>
                        <div class="invalid-feedback text-start" id="emailError" style="display: none;">
                            Format not valid (E.g. example@example.com).
                        </div>
                    </div>
                </div>

                <div class="row mb-3 field-nrc">
                    <div class="col-4 text-start">
                        <label for="nrc_state_id" class="form-label">N.R.C No</label>
                    </div>
                    <div class="col">
                        <div class="row">
                            <div class="col-4 py-1 text-start">
                                <select required="required" autocomplete="on" name="nrc_state_id"
                                        id="nrc_state_id" class="selectpicker"
                                        data-size="15" data-live-search="true" data-width="80%">
                                    <t t-foreach="nrc_states" t-as="nrc_state">
                                        <option t-attf-value="#{nrc_state.id}">
                                            <t t-out="nrc_state.name"/>
                                        </option>
                                    </t>
                                </select>
                                /
                            </div>
                            <div class="col-4 py-1 text-start">
                                <select required="required" title="Choose.." autocomplete="on" name="nrc_district_id"
                                        id="nrc_district_id"
                                        class="selectpicker"
                                        data-live-search="true" data-size="15" data-width="100%">
                                </select>
                            </div>
                            <div class="col-4 py-1 text-start">
                                (
                                <select required="required" autocomplete="on" name="nrc_type_id"
                                        id="nrc_type_id" class="selectpicker w-60"
                                        data-live-search="true" data-size="15" data-width="70%">
                                    <t t-foreach="nrc_types" t-as="nrc_type">
                                        <option t-attf-value="#{nrc_type.id}">
                                            <t t-out="nrc_type.name"/>
                                        </option>
                                    </t>
                                </select>
                                )
                            </div>
                            <div class="col py-1">
                                <input required="required" autocomplete="on" type="text"
                                       name="nrc_number" id="nrc_number"
                                       class="form-control"/>
                                <div class="invalid-feedback text-start">
                                    Format not valid (E.g. 123456).
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3 field-gender">
                    <div class="col-4 text-start">
                        <label for="gender" class="form-label">
                            Gender
                        </label>
                    </div>
                    <div class="col text-start">
                        <select required="required" t-att-value="gender" autocomplete="on" name="gender" id="gender"
                                class="selectpicker" data-size="15">
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3 field-phone">
                    <div class="col-4 text-start">
                        <label for="phone" class="form-label">
                            Phone No.
                        </label>
                    </div>
                    <div class="col">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="basic-addon2">+95</span>
                            </div>

                            <input required="required" autocomplete="on" type="text" name="phone"
                                   id="phone" class="form-control"/>
                        </div>

                        <div class="invalid-feedback text-start" id="phoneError" style="display: none;">
                            Format not valid (E.g. 9441043784).
                        </div>
                    </div>
                </div>

                <div class="row mb-3 field-address-street">
                    <div class="col-4 text-start">
                        <label for="street" class="form-label">
                            Address
                        </label>
                    </div>

                    <div class="col">
                        <div class="row">
                            <div class="col-6 text-start">
                                <select required="required" t-att-value="country_id" autocomplete="on" name="country_id"
                                        id="country_id" class="selectpicker"
                                        data-live-search="true" data-size="15" data-width="100%">
                                    <t t-foreach="countries" t-as="country">
                                        <option t-attf-value="#{country.id}">
                                            <t t-out="country.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <div class="col-6 text-start">
                                <select required="required" t-att-value="state_id" title="State.." autocomplete="on"
                                        name="state_id"
                                        id="state_id" class="selectpicker"
                                        data-live-search="true" data-size="15" data-width="100%">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3 field-address-state">
                    <div class="col-4">
                    </div>
                    <div class="col">
                        <div class="row">

                            <div class="col-6 text-start">
                                <select required="required" t-att-value="township_id" title="Township.."
                                        autocomplete="on"
                                        name="township_id"
                                        id="township_id" class="selectpicker"
                                        data-live-search="true" data-size="15" data-width="100%">

                                </select>
                            </div>

                            <div class="col-6 text-start">
                                <select required="required" t-att-value="ward_id" title="Ward.." autocomplete="on"
                                        name="ward_id"
                                        id="ward_id" class="selectpicker"
                                        data-live-search="true"
                                        data-size="15" data-width="100%">

                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3 field-address-township">
                    <div class="col-4">
                    </div>
                    <div class="col">
                        <input required="required" t-att-value="street" autocomplete="on" type="text" name="street"
                               id="street" class="form-control" placeholder="Street.."/>
                    </div>

                </div>


                <div class="row mb-3 field-company">
                    <div class="col-4 text-start">
                        <label for="Company/Agency" class="form-label">
                            Company/Agency
                        </label>
                    </div>
                    <div class="col text-start">
                        <select required="required" t-att-value="company_id" autocomplete="on" name="parent_id"
                                id="company_id" class="selectpicker"
                                data-size="15"
                                data-width="100%">
                            <option value=""></option>
                            <t t-foreach="parent_companies" t-as="company">
                                <option t-attf-value="#{company.id}">
                                    <t t-out="company.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>

                <div class="row mb-3 field-password">
                    <div class="col-4">
                        <label for="password">Password</label>
                    </div>
                    <div class="col">
                        <div class="input-group">
                            <input type="password" name="password" id="password"
                                   class="form-control form-control-sm"
                                   required="required" t-att-autofocus="'autofocus' if only_passwords else None"/>
                            <div class="input-group-append">
                                <span class="input-group-text" id="toggle-password">Show</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3 field-confirm_password">
                    <div class="col-4">
                        <label for="confirm_password">Confirm Password</label>
                    </div>
                    <div class="col">
                        <div class="input-group">
                            <input type="password" name="confirm_password" id="confirm_password"
                                   class="form-control form-control-sm" required="required"/>
                            <div class="input-group-append">
                                <span class="input-group-text" id="toggle-confirm-password">Show</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3 field-attachment">
                    <div class="col-4">
                    </div>
                    <div class="col">
                        <div class="dashed-border text-center p-3 mt-0">
                            <label for="imageUpload" class="form-label" id="imageUploadArea">
                                <!-- Drop file here -->
                                Drop File Here
                                <br/>
                                <span class="display-0">+</span>
                                <br/>
                            </label>
                            <input type="file" name="attachments" class="form-control d-none" id="attachments"
                                   accept="image/*" multiple="true" data-show-upload="true" data-show-caption="true"
                                   lass="file" data-show-preview="true"/>
                            <br/>
                        </div>
                        <div class="text-center mt-2" style="max-width: 100%;">
                            <div class="d-inline-block text-center p-2"
                                 style="background-color: #f8d7da; color: #721c24; font-size: 0.875rem; max-width: 80%; margin: 0 auto;">
                                <p class="mb-0">Upload agent card red/yellow or AWPT Card</p>
                            </div>
                        </div>
                        <div class="mt-4">
                            <img src="#" alt="" class="img-fluid d-none" id="displayedImage"/>
                        </div>
                    </div>
                </div>

                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <div class="text-center oe_login_buttons d-grid pt-3">
                    <button type="submit" class="btn btn-primary">Sign up</button>
                    <a t-attf-href="/web/login?{{ keep_query() }}" class="btn btn-link btn-sm" role="button">Already
                        have an account?
                    </a>
                    <div class="o_login_auth"/>
                </div>
            </form>
            <script>
                // Function to toggle password visibility
                function toggleVisibility(toggleElement, passwordElement) {
                toggleElement.addEventListener('click', function (e) {
                // Toggle the type attribute using getAttribute() method
                const type = passwordElement.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordElement.setAttribute('type', type);

                // Toggle the text content
                const newText = type === 'password' ? 'Show' : 'Hide';
                this.textContent = newText;
                });
                }

                // Wait for the DOM to be fully loaded
                document.addEventListener('DOMContentLoaded', (event) => {
                // Toggle password visibility for password field
                const togglePassword = document.querySelector('#toggle-password');
                const passwordField = document.querySelector('#password');
                toggleVisibility(togglePassword, passwordField);

                // Toggle password visibility for confirm password field
                const toggleConfirmPassword = document.querySelector('#toggle-confirm-password');
                const confirmPasswordField = document.querySelector('#confirm_password');
                toggleVisibility(toggleConfirmPassword, confirmPasswordField);

                // Validate phone number
                function validatePhoneNumber() {
                var phoneNumber = document.getElementById('phone').value;
                var errorDiv = document.getElementById('phoneError');
                // Check if phone number length exceeds 10 digits or contains non-numeric characters
                if (phoneNumber.length > 10 || !/^\d+$/.test(phoneNumber)) {
                errorDiv.style.display = 'block'; // Show the error message
                } else {
                errorDiv.style.display = 'none'; // Hide the error message if valid
                }
                }
                const phoneInput = document.getElementById('phone');
                phoneInput.addEventListener('input', validatePhoneNumber);

                // Validate email format
                function validateEmail() {
                var email = document.getElementById('login').value;
                var errorDiv = document.getElementById('emailError');
                var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                // Check if the email matches the pattern
                if (!emailPattern.test(email)) {
                errorDiv.style.display = 'block'; // Show the error message
                } else {
                errorDiv.style.display = 'none'; // Hide the error message if valid
                }
                }
                const emailInput = document.getElementById('login');
                emailInput.addEventListener('input', validateEmail);
                });
            </script>
        </xpath>
    </template>

    <template id="agent_login_layout" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('container', 'py-5')]" position="replace">
            <div class="container py-5">
                <div t-attf-class="card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list"
                     style="max-width: 500px;">
                    <div class="card-body">
                        <div t-attf-class="text-center pb-3 border-bottom {{'mb-3' if form_small else 'mb-4'}}">
                            <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Logo"
                                 style="max-height:120px; max-width: 100%; width:auto"/>
                        </div>
                        <t t-out="0"/>
                        <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                            <a href="https://www.mingalarsky.com/" target="_blank">Powered by
                                <span>
                                    <img t-attf-src="/container_truck_appointment/static/img/mscl_logo.png" width="20"/>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>