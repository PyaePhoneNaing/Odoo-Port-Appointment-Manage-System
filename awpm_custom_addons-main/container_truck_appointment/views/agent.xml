<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Agent Form View -->
        <record id="agent_form_view" model="ir.ui.view">
            <field name="name">container_truck_appointment.agent.form</field>
            <field name="model">container.truck.appointment.agent</field>
            <field name="arch" type="xml">
                <form string="Agents">
                    <header>
                        <button name="action_approve" string="Approved" type="object" class="oe_highlight btn-primary"
                                attrs="{'invisible': [('state', 'in', ['approved'])]}" groups="container_truck_appointment.group_awpm_manager"/>
                        <button name="action_reject" string="Reject" type="object" class="oe_highlight btn-danger"
                                attrs="{'invisible': [('state', 'in', ['reject'])]}" groups="container_truck_appointment.group_awpm_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,reject"
                               statusbar_colors='{"reject":"red"}'/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Reject" bg_color="bg-danger"
                                attrs="{'invisible': [('state', 'in', ['draft', 'pending', 'approved'])]}"/>
                        <widget name="web_ribbon" title="Approved" bg_color="bg-primary"
                                attrs="{'invisible': [('state', 'in', ['draft', 'pending', 'reject'])]}"/>
                        <group col="2">
                            <group>
                                <field name="code" placeholder="Code"/>
                                <field name="name" placeholder="Name"/>
                                <field name="gender"/>
                            </group>
                            <group class="oe_custom_group">
                                <field name="image_1920" widget="image" class="oe_image_custom oe_right oe_avatar"
                                       nolabel="1" options="{'preview_image': 'image_128'}"/>
                            </group>
                        </group>
                        <group>
                            <span class="o_form_label o_td_label" name="nrc_information">
                                <b>N.R.C</b>
                            </span>
                            <div class="o_nrc_format">
                                <div class="row">
                                    <div class="col-2">
                                        <field name="nrc_state_id" width="5" placeholder="select"/>
                                        <span>/</span>
                                    </div>
                                    <div class="col">
                                        <field name="nrc_district_id" width="5" placeholder="select"/>
                                    </div>
                                    <div class="col">
                                        <span>(</span>
                                        <field name="nrc_type_id" width="5" placeholder="select"/>
                                        <span>)</span>
                                    </div>
                                    <div class="col-6">
                                        <field name="nrc_number" width="5" placeholder="012345"/>
                                    </div>
                                </div>
                            </div>
                        </group>
                        <!-- Main Fields -->
                        <group col="2">
                            <group>
                                <field name="phone" widget="widget"/>
                                <field name="email" widget="email"/>
                                <field name="color" widget="color"/>
                                <span class="o_form_label o_td_label" name="address_name">
                                    <b>Address</b>
                                </span>
                                <div class="o_address_format">
                                    <div class="row">
                                        <div class="col">
                                            <div name="partner_address_country" class="d-flex justify-content-between">
                                                <field name="country_id" placeholder="Country"
                                                       class="o_address_country"
                                                       options="{'no_open': True, 'no_create': True}"/>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <field name="state_id" class="o_address_state2" placeholder="State"
                                                   options="{'no_open': True, 'no_quick_create': True}"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col">
                                            <field name="township_id" placeholder="Township"
                                                   class="o_address_township"/>
                                        </div>
                                        <div class="col">
                                            <field name="ward_id" placeholder="Ward" class="o_address_ward"/>
                                        </div>
                                    </div>
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                </div>
                            </group>
                            <group>
                                <field name="is_agent" widget="boolean_toggle"/>
                                <field name="parent_id" string="Company/Agency"/>
                                <field name="password" string="Password" readonly="1"/>
                                <field name="user_id" string="Related User" readonly="1"/>
                                <field name="attachments" widget="many2many_binary"/>
                            </group>
                        </group>
                    </sheet>

                    <!-- Odoo Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Agent Tree View -->
        <record id="agent_tree_view" model="ir.ui.view">
            <field name="name">container_truck_appointment.agent.tree</field>
            <field name="model">container.truck.appointment.agent</field>
            <field name="arch" type="xml">
                <tree string="Agents" default_order='state desc'>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="nrc"/>
                    <field name="gender"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="state"
                           decoration-muted="state == 'draft'"
                           decoration-warning="state == 'pending'"
                           decoration-primary="state == 'approved'"
                           decoration-danger="state == 'reject'"
                           widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Agent Search View -->
        <record id="agent_search_view" model="ir.ui.view">
            <field name="name">container.truck.appointment.agent.search</field>
            <field name="model">container.truck.appointment.agent</field>
            <field name="arch" type="xml">
                <search string="Agents">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <group expand="1" string="Group By">
                        <filter string="Code" name="code" domain="[]"
                                context="{'group_by':'code'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Agent Action Window -->
        <record id="agent_act_window" model="ir.actions.act_window">
            <field name="name">Agents</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">container.truck.appointment.agent</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_is_company': True}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no agent click here to add new Agent.
                </p>
            </field>
        </record>

        <!-- Inheriting the contact form view -->
        <record id="view_res_partner_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- Updating the city field to township -->
                <xpath expr="//div/field[@name='street2']" position="after">
                    <div class="row">
                        <div class="col">
                            <field name="ward_id" placeholder="Ward" class="o_address_ward"/>
                        </div>
                        <div class="col">
                            <field name="township_id" placeholder="Township"
                                   class="o_address_township"/>
                        </div>
                    </div>
                </xpath>
                <field name="city" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="zip" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
            </field>
        </record>

    </data>
</odoo>
