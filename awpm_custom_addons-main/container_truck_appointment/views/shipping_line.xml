<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Shipping Line Form View -->
        <record id="shipping_line_form_view" model="ir.ui.view">
            <field name="name">container_truck_appointment.shipping_line.form</field>
            <field name="model">shipping.line</field>
            <field name="arch" type="xml">
                <form string="Shipping Lines">
                    <header>
                        <button name="action_approve" string="Approved" type="object" class="oe_highlight btn-primary"
                                attrs="{'invisible': [('state', 'in', ['approved'])]}" groups="container_truck_appointment.group_awpm_manager"/>
                        <button name="action_reject" string="Reject" type="object" class="oe_highlight btn-danger"
                                attrs="{'invisible': [('state', 'in', ['reject'])]}" groups="container_truck_appointment.group_awpm_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,request,approve,reject"
                               statusbar_colors='{"reject":"red"}'/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Reject" bg_color="bg-danger"
                                attrs="{'invisible': [('state', 'in', ['draft', 'request', 'approve'])]}"/>
                        <widget name="web_ribbon" title="Approved" bg_color="bg-primary"
                                attrs="{'invisible': [('state', 'in', ['draft', 'request', 'reject'])]}"/>
                        <group col="2">
                            <group>
                                <field name="name" placeholder="Shipping Line Name"/>
                                <field name="company_id" placeholder="Company"/>
                                <field name="phone"/>
                            </group>
                            <group class="oe_custom_group">
                                <field name="image_1920" widget="image" class="oe_image_custom oe_right oe_avatar"
                                       nolabel="1" options="{'preview_image': 'image_128'}"/>
                            </group>
                        </group>
                        <!-- Address Fields -->
                       <group col="2">
                            <group>
                                <field name="email" widget="email"/>
                                <span class="o_form_label o_td_label" name="address_name">
                                    <b>Address</b>
                                </span>
                                <div class="o_address_format">
                                    <div class="row">
                                        <div class="col">
                                            <div name="partner_address_country" class="d-flex justify-content-between">
                                                <field name="country_id" placeholder="Country"
                                                       class="o_address_country"
                                                       options="{'no_open': True, 'no_create': True}"/>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <field name="state_id" class="o_address_state2" placeholder="State"
                                                   options="{'no_open': True, 'no_quick_create': True}"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col">
                                            <field name="township_id" placeholder="Township"
                                                   class="o_address_township"/>
                                        </div>
                                        <div class="col">
                                            <field name="ward_id" placeholder="Ward" class="o_address_ward"/>
                                        </div>
                                    </div>
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                </div>
                            </group>
                            <group>
                                <field name="is_shipping_line" widget="boolean_toggle"/>
                                <field name="password" string="Password" readonly="1"/>
                            </group>
                       </group>
                    </sheet>

                    <!-- Odoo Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Shipping Line Tree View -->
        <record id="shipping_line_tree_view" model="ir.ui.view">
            <field name="name">container_truck_appointment.shipping_line.tree</field>
            <field name="model">shipping.line</field>
            <field name="arch" type="xml">
                <tree string="Shipping Lines" default_order='state desc'>
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="state"
                           decoration-muted="state == 'draft'"
                           decoration-warning="state == 'request'"
                           decoration-primary="state == 'approve'"
                           decoration-danger="state == 'reject'"
                           widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Shipping Line Search View -->
        <record id="shipping_line_search_view" model="ir.ui.view">
            <field name="name">container.truck.appointment.shipping_line.search</field>
            <field name="model">shipping.line</field>
            <field name="arch" type="xml">
                <search string="Shipping Lines">
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <group expand="1" string="Group By">
                        <filter string="Company" name="company_id" domain="[]" context="{'group_by':'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Shipping Line Action Window -->
        <record id="shipping_line_act_window" model="ir.actions.act_window">
            <field name="name">Shipping Lines</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">shipping.line</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_is_company': True}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no shipping line, click here to add a new Shipping Line.
                </p>
            </field>
        </record>

       <record id="view_res_partner_form_inherit_shipping_line" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.shipping.line</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
        <xpath expr="//div/field[@name='street2']" position="after">
            <div class="row">
                <div class="col">
                    <field name="ward_id" placeholder="Ward" class="o_address_ward"/>
                </div>
                <div class="col">
                    <field name="township_id" placeholder="Township" class="o_address_township"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//field[@name='city']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='zip']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
    </field>
</record>

    </data>
</odoo>
